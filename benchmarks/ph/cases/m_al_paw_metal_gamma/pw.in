&CONTROL
  calculation = 'scf'
  prefix      = 'al'
  outdir      = './out'
  verbosity   = 'low'
/
&SYSTEM
  ibrav = 2
  celldm(1) = 7.60
  nat = 1
  ntyp = 1
  ecutwfc = 30.0
  ecutrho = 240.0
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.05
/
&ELECTRONS
  conv_thr = 1.0d-12
  mixing_beta = 0.7
  electron_maxstep = 200
/
ATOMIC_SPECIES
  Al     26.98150  Al.pbesol-n-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS alat
  Al  0.00 0.00 0.00
K_POINTS automatic
  8 8 8 0 0 0
