&CONTROL
  calculation = 'scf'
  prefix      = 'mos2'
  outdir      = './out'
  verbosity   = 'low'
/
&SYSTEM
  ibrav = 4
  celldm(1) = 5.971
  celldm(3) = 6.329
  nat = 3
  ntyp = 2
  ecutwfc = 80.0
  ecutrho = 320.0
  occupations = 'fixed'
  assume_isolated = '2D'
/
&ELECTRONS
  conv_thr = 1.0d-12
  mixing_beta = 0.7
  electron_maxstep = 200
/
ATOMIC_SPECIES
  Mo     95.95000  Mo.dojo-sr-04-pbe-std.upf
  S      32.06000  S.dojo-sr-04-pbe-std.upf
ATOMIC_POSITIONS crystal
  Mo  0.333333333333 0.666666666667 0.500000000000
  S   0.666666666667 0.333333333333 0.578008387102
  S   0.666666666667 0.333333333333 0.421991612898
K_POINTS automatic
  12 12 1 0 0 0
