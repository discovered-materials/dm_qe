&CONTROL
  calculation = 'scf'
  prefix      = 'mgo'
  outdir      = './out'
  verbosity   = 'low'
/
&SYSTEM
  ibrav = 2
  celldm(1) = 7.96
  nat = 2
  ntyp = 2
  ecutwfc = 85.0
  ecutrho = 340.0
  occupations = 'fixed'
/
&ELECTRONS
  conv_thr = 1.0d-12
  mixing_beta = 0.7
  electron_maxstep = 200
/
ATOMIC_SPECIES
  Mg     24.30500  Mg.dojo-sr-04-pbe-std.upf
  O      15.99900  O.dojo-sr-04-pbe-std.upf
ATOMIC_POSITIONS alat
  Mg  0.00 0.00 0.00
  O   0.50 0.50 0.50
K_POINTS automatic
  8 8 8 0 0 0
