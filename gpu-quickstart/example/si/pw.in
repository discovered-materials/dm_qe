&CONTROL
  calculation = 'scf'
  prefix      = 'si'
  pseudo_dir  = './pseudo'
  outdir      = './out'
  verbosity   = 'low'
/
&SYSTEM
  ibrav = 2
  celldm(1) = 10.261213
  nat = 2
  ntyp = 1
  ecutwfc = 30.0
  ecutrho = 240.0
  occupations = 'fixed'
/
&ELECTRONS
  conv_thr = 1.0d-12
  mixing_beta = 0.7
  electron_maxstep = 200
/
ATOMIC_SPECIES
  Si     28.08550  Si.pbesol-n-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS alat
  Si  0.00 0.00 0.00
  Si  0.25 0.25 0.25
K_POINTS automatic
  4 4 4 0 0 0
